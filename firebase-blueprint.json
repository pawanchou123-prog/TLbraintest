    "Question": {
      "title": "Question",
      "description": "Educational quiz or GK question managed via Question Management Application (/question-manager) and consumed by Student App (/app).",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "UID of Admin or Question Manager who created the question." },
        "authorEmail": { "type": "string", "description": "Optional verified Gmail address of the question creator." },
        "studentClass": { "type": "integer", "description": "0 for General Knowledge (GK), or 1 to 12 for school classes." },
        "subject": { "type": "string", "description": "Subject name." },
        "topic": { "type": "string", "description": "Optional topic or chapter title." },
        "language": { "type": "string", "enum": ["en", "hi"], "description": "Question language." },
        "questionText": { "type": "string", "description": "Question prompt text." },
        "options": { "type": "array", "description": "Four multiple-choice answer strings." },
        "correctIndex": { "type": "integer", "description": "Zero-based index (0 to 3) of the correct option." },
        "explanation": { "type": "string", "description": "Detailed solution explanation." },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"], "description": "Question difficulty tier." },
        "points": { "type": "integer", "description": "XP points awarded for correct response." },
        "timerSeconds": { "type": "integer", "description": "Per-question countdown timer in seconds." },
        "imageUrl": { "type": "string", "description": "Optional HTTPS image URL." },
        "isPublished": { "type": "boolean", "description": "False while in draft/review/rejected state; true only when approved and live for students." },
        "reviewStatus": { "type": "string", "enum": ["draft", "pending_review", "approved", "rejected"], "description": "Editorial review lifecycle status." },
        "reviewNotes": { "type": "string", "description": "Optional Main Admin approval or rejection notes." },
        "lastEditedByUid": { "type": "string", "description": "Optional UID of most recent editor." },
        "lastEditedByEmail": { "type": "string", "description": "Optional Gmail of most recent editor." },
        "source": { "type": "string", "enum": ["manual", "gemini_ai", "csv_import"], "description": "Authoring origin." },
        "attemptsCount": { "type": "integer", "description": "Total student attempts." },
        "correctCount": { "type": "integer", "description": "Total correct student responses." },
        "totalResponseTimeSec": { "type": "integer", "description": "Cumulative response seconds for average speed stats." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": [
        "authorId",
        "studentClass",
        "subject",
        "language",
        "questionText",
        "options",
        "correctIndex",
        "explanation",
        "difficulty",
        "points",
        "timerSeconds",
        "imageUrl",
        "isPublished",
        "source",
        "attemptsCount",
        "correctCount",
        "totalResponseTimeSec",
        "createdAt",
        "updatedAt"
      ]
    },
