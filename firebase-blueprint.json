        "editorEmail",
        "editorRole",
        "actionType",
        "questionId",
        "questionSummary",
        "details",
        "createdAt"
      ]
    },
    "AllowedStudent": {
      "title": "AllowedStudent",
      "description": "Admin-managed invite-only student whitelist, ban control, and manual subscription record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Whitelisted lowercase Gmail address." },
