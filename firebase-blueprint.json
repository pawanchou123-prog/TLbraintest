        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": [
        "studentEmail",
        "studentName",
        "studentClass",
        "studentUid",
        "amountInr",
        "planLabel",
        "paymentMethod",
        "referenceCode",
        "status",
        "startMs",
        "endMs",
        "verificationNotes",
        "verifiedByAdminEmail",
        "createdAt",
        "updatedAt"
      ]
    },
