        "paymentMethod",
        "subscriptionStartMs",
        "subscriptionEndMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "Access request, manual Rs. 50 / 3-month payment verification request, or historical subscription transaction record.",
      "type": "object",
      "properties": {
        "studentEmail": { "type": "string", "description": "Lowercase student Gmail address." },
