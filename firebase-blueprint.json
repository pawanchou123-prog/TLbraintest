        "adminNotes": { "type": "string", "description": "Optional payment reference or notes." },
        "linkedUid": { "type": "string", "description": "Linked Firebase UID once student signs in." },
        "lastActiveSummary": { "type": "string", "description": "Latest daily activity summary string." },
