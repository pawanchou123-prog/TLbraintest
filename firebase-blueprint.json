{
  "entities": {
    "RoleMember": {
      "title": "RoleMember",
      "description": "Administrator or Question Manager role assignment document keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the privileged user." },
        "email": { "type": "string", "description": "Verified Gmail address." },
        "name": { "type": "string", "description": "Display name of the operator." },
        "role": { "type": "string", "enum": ["admin", "question_manager"], "description": "Assigned role." },
        "emailKey": { "type": "string", "description": "Optional sanitized email key linking to /allowed_question_managers/{emailKey}." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["uid", "email", "name", "role", "createdAt", "updatedAt"]
    },
    "AllowedQuestionManager": {
      "title": "AllowedQuestionManager",
      "description": "Main Admin managed allowlist and permission record for Question Management App operators.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Whitelisted lowercase Gmail address of the Question Manager." },
        "managerName": { "type": "string", "description": "Full name of the Question Manager." },
        "isActive": { "type": "boolean", "description": "True when authorized to access /question-manager; false when suspended." },
        "canPublishDirectly": { "type": "boolean", "description": "True if Main Admin allows direct publishing; false requires Main Admin review." },
        "canDeleteQuestions": { "type": "boolean", "description": "True if manager may delete their own unpublished questions." },
        "addedByAdminEmail": { "type": "string", "description": "Main Admin Gmail who authorized this manager." },
        "notes": { "type": "string", "description": "Optional Main Admin internal notes." },
        "linkedUid": { "type": "string", "description": "Linked Firebase Auth UID once the Question Manager signs in." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": [
        "email",
        "managerName",
        "isActive",
        "canPublishDirectly",
        "canDeleteQuestions",
        "addedByAdminEmail",
        "createdAt",
        "updatedAt"
      ]
    },
